@model RentalContract
@{ ViewData["Title"] = "Novo contrato"; }

<section class="management-page form-page">
    <div class="page-heading management-heading">
        <div>
            <p class="eyebrow">ALUGUERES <span>·</span> NOVO CONTRATO</p>
            <h1>Novo contrato de aluguer</h1>
            <p class="heading-copy">Associa um cliente a um veículo e define o período do aluguer.</p>
        </div>
        <a class="secondary-button" asp-action="Index"><span aria-hidden="true">←</span> Voltar aos alugueres</a>
    </div>

    <form asp-action="Create" method="post" class="panel entity-form">
        <div asp-validation-summary="ModelOnly" class="form-errors" role="alert"></div>
        <partial name="_Fields" model="Model" />
        <div class="form-actions"><a class="secondary-button" asp-action="Index">Cancelar</a><button class="primary-button" type="submit">Guardar contrato <span aria-hidden="true">→</span></button></div>
    </form>
</section>
@section Scripts { <partial name="_FormScripts" /> }
