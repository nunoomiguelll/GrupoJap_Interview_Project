@model IReadOnlyList<GrupoJap.Rentals.ViewModels.RentalListItemViewModel>
@using GrupoJap.Rentals.Services
@{ ViewData["Title"] = T["nav.rentals"].Value; }

<section class="management-page">
    <div class="page-heading management-heading">
        <div>
            <partial name="_Eyebrow" model="@T["rentals.eyebrow"].Value" />
            <h1>@T["rentals.heading"]</h1>
            <p class="heading-copy">@T["rentals.count", Model.Count]</p>
        </div>
        <a class="primary-button" asp-action="Create"><span aria-hidden="true">＋</span> @T["rentals.add"]</a>
    </div>

    <partial name="_Notices" />

    <section class="panel management-panel" aria-label="@T["rentals.list_label"]">
        <div class="table-wrap">
            <table class="management-table">
                <thead><tr><th>@T["rentals.th_customer"]</th><th>@T["rentals.th_vehicle"]</th><th>@T["rentals.th_period"]</th><th>@T["rentals.th_initial_km"]</th><th>@T["common.th_status"]</th><th></th></tr></thead>
                <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6"><div class="empty-state"><span class="empty-mark" aria-hidden="true">—</span><strong>@T["rentals.empty_title"]</strong><span>@T["rentals.empty_text"]</span><a class="text-link" asp-action="Create">@T["rentals.add"] <span aria-hidden="true">→</span></a></div></td></tr>
                }
                else
                {
                    foreach (var rental in Model)
                    {
                        var (css, labelKey) = rental.Status switch
                        {
                            RentalStatus.Active => ("is-active", "status.active"),
                            RentalStatus.Upcoming => ("is-upcoming", "status.upcoming"),
                            _ => ("is-complete", "status.completed")
                        };
                        <tr>
                            <td><strong>@rental.CustomerName</strong></td>
                            <td><div class="entity-cell"><span><strong>@rental.VehicleName</strong><small>@rental.Registration</small></span></div></td>
                            <td><span class="date-range">@rental.StartDate.ToString("dd/MM/yyyy")<i>→</i>@rental.EndDate.ToString("dd/MM/yyyy")</span></td>
                            <td>@rental.InitialMileage.ToString("N0")</td>
                            <td><span class="rental-status @css"><i></i>@T[labelKey]</span></td>
                            <td><div class="row-actions"><a asp-action="Edit" asp-route-id="@rental.Id">@T["common.edit"]</a><a class="is-danger" asp-action="Delete" asp-route-id="@rental.Id">@T["common.delete"]</a></div></td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </section>
</section>
