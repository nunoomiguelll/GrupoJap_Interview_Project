@model RentalContract
@{ ViewData["Title"] = T["rentals.delete_title"].Value; }

<section class="management-page">
    <div class="page-heading management-heading">
        <div><partial name="_Eyebrow" model="@T["rentals.eyebrow_delete"].Value" /><h1>@T["rentals.delete_title"]</h1></div>
    </div>
    <div class="panel confirm-panel">
        <dl>
            <dt>@T["field.customer"]</dt><dd>@Model.Customer?.FullName</dd>
            <dt>@T["field.vehicle"]</dt><dd>@Model.Vehicle?.Brand @Model.Vehicle?.Model (@Model.Vehicle?.Registration)</dd>
            <dt>@T["field.period"]</dt><dd>@Model.StartDate?.ToString("dd/MM/yyyy") – @Model.EndDate?.ToString("dd/MM/yyyy")</dd>
        </dl>
        <p>@T["rentals.delete_confirm"]</p>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="form-actions">
            <a class="secondary-button" asp-action="Index">@T["common.cancel"]</a>
            <button class="danger-button" type="submit">@T["common.delete"]</button>
        </form>
    </div>
</section>
