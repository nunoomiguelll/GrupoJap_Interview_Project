@model RentalContract
@using Microsoft.AspNetCore.Mvc.Rendering
<div class="form-grid">
    <div class="field-group"><label asp-for="CustomerId"></label><select asp-for="CustomerId" asp-items="(IEnumerable<SelectListItem>)ViewBag.Customers"><option value="">@T["rentals.select_customer"]</option></select><span asp-validation-for="CustomerId"></span></div>
    <div class="field-group"><label asp-for="VehicleId"></label><select asp-for="VehicleId" asp-items="(IEnumerable<SelectListItem>)ViewBag.Vehicles"><option value="">@T["rentals.select_vehicle"]</option></select><span asp-validation-for="VehicleId"></span></div>
    <div class="field-group"><label asp-for="StartDate"></label><input asp-for="StartDate" type="date" /><span asp-validation-for="StartDate"></span></div>
    <div class="field-group"><label asp-for="EndDate"></label><input asp-for="EndDate" type="date" /><span asp-validation-for="EndDate"></span></div>
    <div class="field-group"><label asp-for="InitialMileage"></label><input asp-for="InitialMileage" type="number" min="0" inputmode="numeric" /><span asp-validation-for="InitialMileage"></span></div>
</div>
