@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    var currentUser = User.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(User) : null;
}
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string NavClass(string controller) => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? "is-current" : string.Empty;
}
<!DOCTYPE html>
<html lang="@SiteLanguages.CurrentLanguage.Culture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f6f3f1" />
    <script>
        (function () {
            var theme = null;
            try { theme = localStorage.getItem("theme"); } catch (e) { }
            if (theme !== "dark" && theme !== "light") {
                theme = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
            }
            document.documentElement.dataset.theme = theme;
        })();
    </script>
    <title>@ViewData["Title"] · GrupoJap Rentals</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/_content/GrupoJap.Rentals.Core/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <div class="app-frame">
        <aside class="sidebar" id="app-sidebar" aria-label="@T["nav.label"]">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="@T["brand.label"]">
                <span class="brand-mark" aria-hidden="true"><span></span><span></span></span>
                <span class="brand-copy"><strong>GrupoJap</strong><small>FLEET OPERATIONS</small></span>
            </a>

            <span class="site-button is-disabled" aria-disabled="true" role="link" title="@T["nav.site_status"]">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>
                <span><strong>@T["nav.site"]</strong><small>@T["nav.site_status"]</small></span>
            </span>

            @if (User.IsInRole("Admin"))
            {
            <nav class="primary-nav">
                <p class="nav-label">@T["nav.operation"]</p>
                <a class="nav-link @NavClass("Home")" asp-controller="Home" asp-action="Index">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="7" height="7" rx="1"/><rect x="13.5" y="3.5" width="7" height="7" rx="1"/><rect x="3.5" y="13.5" width="7" height="7" rx="1"/><rect x="13.5" y="13.5" width="7" height="7" rx="1"/></svg>
                    <span>@T["nav.dashboard"]</span>
                </a>
                <a class="nav-link @NavClass("Vehicles")" asp-controller="Vehicles" asp-action="Index">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 13.5 5.1 8a2 2 0 0 1 1.8-1.2h10.2A2 2 0 0 1 18.9 8l2.1 5.5v5h-2v-2H5v2H3z"/><path d="M5.2 13.5h13.6M7 17h.01M17 17h.01M7 10h10"/></svg>
                    <span>@T["nav.vehicles"]</span>
                </a>
                <a class="nav-link @NavClass("Customers")" asp-controller="Customers" asp-action="Index">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.8 20v-1.2A6.2 6.2 0 0 1 9 12.6a6.2 6.2 0 0 1 6.2 6.2V20zM16 5.2a3.5 3.5 0 0 1 0 6.7M17.4 13a5 5 0 0 1 3.8 4.9V20h-4"/></svg>
                    <span>@T["nav.customers"]</span>
                </a>
                <a class="nav-link @NavClass("Rentals")" asp-controller="Rentals" asp-action="Index">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="2"/><path d="M7.5 3.5v3M16.5 3.5v3M3.5 9.5h17M7.5 13h3M7.5 16.5h7"/></svg>
                    <span>@T["nav.rentals"]</span>
                </a>

                <p class="nav-label nav-label-secondary">@T["nav.system"]</p>
                <a class="nav-link @NavClass("Profile")" asp-controller="Profile" asp-action="Index">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4.5 20.5v-1a5.5 5.5 0 0 1 5.5-5.5h4a5.5 5.5 0 0 1 5.5 5.5v1"/></svg>
                    <span>@T["nav.my_profile"]</span>
                </a>
                <a class="nav-link @NavClass("Translations")" asp-controller="Translations" asp-action="Index">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h9M8.5 3v2M6 5c.6 3.2 2.6 5.7 5.5 7M11 5c-.8 3.6-3.2 6.6-7 8.5"/><path d="m12.5 21 4.2-10 4.3 10M14 17.5h5.4"/></svg>
                    <span>@T["nav.translations"]</span>
                </a>
                <span class="nav-link is-unavailable" aria-disabled="true" title="@T["nav.soon_hint"]">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="m19.4 15 .1.1a1.7 1.7 0 0 1-2.4 2.4l-.1-.1a1.7 1.7 0 0 0-2.9 1.2v.2a1.7 1.7 0 0 1-3.4 0v-.2a1.7 1.7 0 0 0-2.9-1.2l-.1.1a1.7 1.7 0 0 1-2.4-2.4l.1-.1a1.7 1.7 0 0 0-1.2-2.9H4a1.7 1.7 0 0 1 0-3.4h.2a1.7 1.7 0 0 0 1.2-2.9l-.1-.1a1.7 1.7 0 0 1 2.4-2.4l.1.1a1.7 1.7 0 0 0 2.9-1.2V2a1.7 1.7 0 0 1 3.4 0v.2a1.7 1.7 0 0 0 2.9 1.2l.1-.1a1.7 1.7 0 0 1 2.4 2.4l-.1.1a1.7 1.7 0 0 0 1.2 2.9h.2a1.7 1.7 0 0 1 0 3.4h-.2a1.7 1.7 0 0 0-1.2 2.9z"/></svg>
                    <span>@T["nav.settings"]</span><small>@T["nav.soon"]</small>
                </span>
            </nav>
            }

            <div class="sidebar-bottom">
                <div class="connection-state"><span class="connection-dot"></span><span><strong>SQL Server</strong><small>@T["sidebar.db_status"]</small></span></div>
                @if (currentUser is not null)
                {
                    var roleLabel = !string.IsNullOrWhiteSpace(currentUser.JobTitle) ? currentUser.JobTitle : T[User.IsInRole("Admin") ? "profile.role_admin" : "profile.role_user"].Value;
                    <a class="user-profile" asp-controller="Profile" asp-action="Index" title="@T["nav.edit_profile"]">
                        <span class="user-avatar">@if (!string.IsNullOrEmpty(currentUser.PhotoPath)) { <img src="@currentUser.PhotoPath" alt="" /> } else { @currentUser.Initial }</span>
                        <span><strong title="@currentUser.DisplayName">@currentUser.DisplayName</strong><small>@roleLabel</small></span>
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form"><button class="logout-button" type="submit">@T["nav.logout"]</button></form>
                }
                else
                {
                    <a class="logout-button" asp-controller="Account" asp-action="Login">@T["nav.login"]</a>
                }
            </div>
        </aside>

        <button class="sidebar-scrim" type="button" data-sidebar-close aria-label="@T["nav.close_navigation"]"></button>

        <div class="app-main">
            <header class="topbar">
                <button class="icon-button menu-toggle" type="button" data-sidebar-toggle aria-label="@T["nav.open_navigation"]" aria-controls="app-sidebar" aria-expanded="false">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6.5h16M4 12h16M4 17.5h16"/></svg>
                </button>
                <div class="breadcrumbs"><span>GrupoJap</span><span class="breadcrumb-divider">/</span><strong>@ViewData["Title"]</strong></div>
                <div class="topbar-right"><partial name="_LanguageMenu" /><button class="icon-button theme-toggle" type="button" data-theme-toggle data-label-dark="@T["theme.to_dark"]" data-label-light="@T["theme.to_light"]" aria-pressed="false" aria-label="@T["theme.to_dark"]" title="@T["theme.toggle"]"><svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7z"/></svg><svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2.5 12h2M19.5 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg></button><span class="topbar-date">@T["topbar.fleet"] <span>·</span> @DateTime.Today.ToString("dd MMM yyyy").ToUpperInvariant()</span><a class="topbar-avatar" asp-controller="Profile" asp-action="Index" title="@T["nav.my_profile"]">@if (currentUser is not null && !string.IsNullOrEmpty(currentUser.PhotoPath)) { <img src="@currentUser.PhotoPath" alt="" /> } else { @(currentUser?.Initial ?? "GJ") }</a></div>
            </header>

            <main class="page-content" role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/_content/GrupoJap.Rentals.Core/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
