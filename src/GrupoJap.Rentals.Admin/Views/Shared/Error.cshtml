@model ErrorViewModel
@{
    ViewData["Title"] = T["error.title"].Value;
}

<section class="management-page">
    <div class="page-heading management-heading">
        <div>
            <h1>@T["error.title"]</h1>
            <p class="heading-copy">@T["error.text"]</p>
        </div>
    </div>

    @if (Model.ShowRequestId)
    {
        <p><strong>@T["error.request_id"]:</strong> <code>@Model.RequestId</code></p>
    }

    <a class="secondary-button" asp-controller="Home" asp-action="Index">@T["common.back_home"]</a>
</section>
