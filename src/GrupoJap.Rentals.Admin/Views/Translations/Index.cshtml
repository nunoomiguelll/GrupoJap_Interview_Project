@model GrupoJap.Rentals.ViewModels.TranslationIndexViewModel
@{
    ViewData["Title"] = T["nav.translations"].Value;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;

    Dictionary<string, string?> RouteFor(int page) => new()
    {
        ["q"] = Model.Q,
        ["category"] = Model.Category,
        ["onlyMissing"] = Model.OnlyMissing ? "true" : null,
        ["page"] = page == 1 ? null : page.ToString()
    };
}

<section class="management-page">
    <div class="page-heading management-heading">
        <div>
            <partial name="_Eyebrow" model="@T["tr.eyebrow"].Value" />
            <h1>@T["tr.heading"]</h1>
            <p class="heading-copy">@T["tr.count", Model.TotalCount]</p>
        </div>
        <a class="primary-button" asp-action="Create" asp-route-category="@Model.Category"><span aria-hidden="true">＋</span> @T["tr.add"]</a>
    </div>

    <partial name="_Notices" />

    <form method="get" asp-action="Index" class="panel translation-filters">
        <div class="field-group translation-search">
            <label for="q">@T["tr.search"]</label>
            <input id="q" type="search" name="q" value="@Model.Q" placeholder="@T["tr.search_placeholder"]" autocomplete="off" />
        </div>
        <div class="field-group">
            <label for="category">@T["field.category"]</label>
            <select id="category" name="category" onchange="this.form.submit()">
                <option value="">@T["tr.all_categories"]</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category" selected="@(category == Model.Category)">@category</option>
                }
            </select>
        </div>
        <label class="check-row translation-missing">
            <input type="checkbox" name="onlyMissing" value="true" checked="@Model.OnlyMissing" onchange="this.form.submit()" />
            @T["tr.only_incomplete"]
            @if (Model.MissingCount > 0)
            {
                <span class="missing-count">@Model.MissingCount</span>
            }
        </label>
        <div class="translation-filter-actions">
            <button class="primary-button" type="submit">@T["tr.filter"]</button>
            <a class="secondary-button" asp-action="Index">@T["tr.clear"]</a>
        </div>
    </form>

    <section class="panel management-panel" aria-label="@T["tr.list_label"]">
        <div class="table-wrap">
            <table class="management-table translation-table">
                <thead>
                    <tr>
                        <th>@T["tr.th_key"]</th>
                        @foreach (var language in SiteLanguages.All)
                        {
                            <th><span class="lang-badge">@language.Code.ToUpperInvariant()</span> @language.Name.ToUpperInvariant()</th>
                        }
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="@(SiteLanguages.All.Count + 2)"><div class="empty-state"><span class="empty-mark" aria-hidden="true">—</span><strong>@T["tr.empty_title"]</strong><span>@T["tr.empty_text"]</span></div></td></tr>
                }
                else
                {
                    foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="translation-key-cell">
                                <code class="translation-key">@item.Key</code>
                                <small><span class="category-chip">@item.Category</span>@if (!string.IsNullOrEmpty(item.Description)) { <span>@item.Description</span> }</small>
                            </td>
                            @foreach (var language in SiteLanguages.All)
                            {
                                var value = item.Values.GetValueOrDefault(language.Code);
                                <td class="translation-value" lang="@language.Culture">
                                    @if (string.IsNullOrWhiteSpace(value))
                                    {
                                        <span class="missing-badge">@T["tr.missing"]</span>
                                    }
                                    else
                                    {
                                        <span title="@value">@value</span>
                                    }
                                </td>
                            }
                            <td><div class="row-actions"><a asp-action="Edit" asp-route-id="@item.Id" asp-route-returnUrl="@returnUrl">@T["common.edit"]</a><a class="is-danger" asp-action="Delete" asp-route-id="@item.Id">@T["common.delete"]</a></div></td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
        @if (Model.TotalPages > 1)
        {
            <nav class="panel-bottom admin-pagination" aria-label="@T["tr.pagination"]">
                <span>@T["tr.page_of", Model.Page, Model.TotalPages]</span>
                <div>
                    @if (Model.Page > 1)
                    {
                        <a class="secondary-button" asp-action="Index" asp-all-route-data="RouteFor(Model.Page - 1)!" rel="prev">@T["tr.prev"]</a>
                    }
                    @if (Model.Page < Model.TotalPages)
                    {
                        <a class="secondary-button" asp-action="Index" asp-all-route-data="RouteFor(Model.Page + 1)!" rel="next">@T["tr.next"]</a>
                    }
                </div>
            </nav>
        }
    </section>
</section>
