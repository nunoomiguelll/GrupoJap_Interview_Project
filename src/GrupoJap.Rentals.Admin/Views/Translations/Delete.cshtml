@model Translation
@{ ViewData["Title"] = T["tr.delete_title"].Value; bool isCatalogKey = ViewBag.IsCatalogKey; }

<section class="management-page">
    <div class="page-heading management-heading">
        <div><partial name="_Eyebrow" model="@T["tr.eyebrow_delete"].Value" /><h1>@T["tr.delete_title"]</h1></div>
    </div>
    <div class="panel confirm-panel">
        <dl>
            <dt>@T["field.key"]</dt><dd><code class="translation-key">@Model.Key</code></dd>
            <dt>@T["field.category"]</dt><dd>@Model.Category</dd>
            @foreach (var language in SiteLanguages.All)
            {
                <dt>@language.Name</dt><dd>@(Model.Values.FirstOrDefault(v => v.Language == language.Code)?.Value is { Length: > 0 } value ? value : "—")</dd>
            }
        </dl>
        @if (isCatalogKey)
        {
            <div class="notice notice-success" role="status">@T["tr.delete_catalog_notice"]</div>
        }
        else
        {
            <p>@T["tr.delete_confirm"]</p>
        }
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="form-actions">
            <a class="secondary-button" asp-action="Index">@T["common.cancel"]</a>
            <button class="danger-button" type="submit">@T["common.delete"]</button>
        </form>
    </div>
</section>
