@model GrupoJap.Rentals.ViewModels.TranslationFormViewModel
@{
    var isEdit = Model.Id is not null;
    ViewData["Title"] = T[isEdit ? "tr.edit_title" : "tr.add"].Value;
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<section class="management-page form-page">
    <div class="page-heading management-heading">
        <div>
            <partial name="_Eyebrow" model="@T[isEdit ? "tr.eyebrow_edit" : "tr.eyebrow_new"].Value" />
            <h1>@ViewData["Title"]</h1>
            <p class="heading-copy">
                @if (isEdit)
                {
                    <code class="translation-key">@Model.Key</code>
                }
                else
                {
                    <span>@T["tr.create_hint"]</span>
                }
            </p>
        </div>
        <a class="secondary-button" href="@(returnUrl ?? Url.Action("Index"))"><span aria-hidden="true">←</span> @T["tr.back"]</a>
    </div>

    <form method="post" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" class="panel entity-form">
        <div asp-validation-summary="ModelOnly" class="form-errors" role="alert"></div>
        <input type="hidden" name="returnUrl" value="@returnUrl" />

        <div class="form-grid">
            <div class="field-group">
                <label asp-for="Key"></label>
                @if (isEdit)
                {
                    <input asp-for="Key" readonly />
                    <small class="field-hint">@T["tr.key_readonly"]</small>
                }
                else
                {
                    <input asp-for="Key" maxlength="200" autocomplete="off" placeholder="@T["tr.key_placeholder"]" autofocus />
                    <span asp-validation-for="Key"></span>
                }
            </div>
            <div class="field-group">
                <label asp-for="Category"></label>
                <input asp-for="Category" maxlength="100" list="translation-categories" autocomplete="off" placeholder="@T["tr.category_placeholder"]" />
                <datalist id="translation-categories">
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category"></option>
                    }
                </datalist>
                <span asp-validation-for="Category"></span>
            </div>
        </div>
        <div class="field-group">
            <label asp-for="Description"></label>
            <input asp-for="Description" maxlength="500" placeholder="@T["tr.description_placeholder"]" />
            <span asp-validation-for="Description"></span>
        </div>

        <div class="translation-languages">
            @foreach (var language in SiteLanguages.All)
            {
                var fieldName = $"Values[{language.Code}]";
                var fieldId = $"value-{language.Code}";
                var isDefault = language.Code == SiteLanguages.Default;
                var original = Model.Defaults?.GetValueOrDefault(language.Code);
                <div class="field-group translation-language">
                    <label for="@fieldId"><span class="lang-badge">@language.Code.ToUpperInvariant()</span> @language.Name @(isDefault ? T["tr.required"].Value : "")</label>
                    <textarea id="@fieldId" name="@fieldName" rows="3" lang="@language.Culture" required="@isDefault">@Model.Values.GetValueOrDefault(language.Code)</textarea>
                    @Html.ValidationMessage(fieldName)
                    @if (!string.IsNullOrEmpty(original))
                    {
                        <small class="field-hint">@T["tr.original"] <span>@original</span> <button class="text-button" type="button" data-fill-target="@fieldId" data-fill-value="@original">@T["tr.reset"]</button></small>
                    }
                    else if (!isDefault)
                    {
                        <small class="field-hint">@T["tr.empty_hint"]</small>
                    }
                </div>
            }
        </div>

        <div class="form-actions"><a class="secondary-button" href="@(returnUrl ?? Url.Action("Index"))">@T["common.cancel"]</a><button class="primary-button" type="submit">@T[isEdit ? "common.save_changes" : "tr.create"] <span aria-hidden="true">→</span></button></div>
    </form>
</section>
@section Scripts {
    <partial name="_FormScripts" />
    <script>
        // Reset: puts the catalog's original text back into the field (only saved on submit).
        for (const button of document.querySelectorAll("[data-fill-target]")) {
            button.addEventListener("click", () => {
                const field = document.getElementById(button.dataset.fillTarget);
                field.value = button.dataset.fillValue;
                field.focus();
            });
        }
    </script>
}
