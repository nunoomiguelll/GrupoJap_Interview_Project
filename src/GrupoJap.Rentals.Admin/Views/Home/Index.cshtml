@model GrupoJap.Rentals.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = T["dash.title"].Value;
}

<section class="dashboard" id="overview">
    <div class="page-heading">
        <div>
            <partial name="_Eyebrow" model="@(T["topbar.fleet"].Value + " · " + DateTime.Today.ToString("dd MMMM yyyy").ToUpper())" />
            <h1>@T["dash.heading"]</h1>
            <p class="heading-copy">@T["dash.lead"]</p>
        </div>
        <div class="heading-mark" aria-hidden="true"><span>GJ</span><i></i></div>
    </div>

    <section class="metric-grid" aria-label="@T["dash.metrics_label"]">
        <article class="metric-card metric-featured">
            <div class="metric-topline"><span class="metric-label">@T["dash.fleet_vehicles"]</span><span class="metric-index">01</span></div>
            <div class="metric-value">@Model.VehicleCount.ToString("00")</div>
            <div class="metric-foot"><span class="metric-accent"></span><span>@T["dash.registered_units"]</span></div>
        </article>
        <article class="metric-card">
            <div class="metric-topline"><span class="metric-label">@T["dash.available_today"]</span><span class="metric-icon metric-icon-green" aria-hidden="true">↗</span></div>
            <div class="metric-value">@Model.AvailableVehicleCount.ToString("00")</div>
            <div class="metric-foot"><span class="metric-status status-ready"></span><span>@T["dash.ready_to_rent"]</span></div>
        </article>
        <article class="metric-card">
            <div class="metric-topline"><span class="metric-label">@T["dash.active_rentals"]</span><span class="metric-icon metric-icon-red" aria-hidden="true">↗</span></div>
            <div class="metric-value">@Model.ActiveRentalCount.ToString("00")</div>
            <div class="metric-foot"><span class="metric-status status-rented"></span><span>@T["dash.in_progress_today"]</span></div>
        </article>
        <article class="metric-card">
            <div class="metric-topline"><span class="metric-label">@T["nav.customers"]</span><span class="metric-icon metric-icon-yellow" aria-hidden="true">↗</span></div>
            <div class="metric-value">@Model.CustomerCount.ToString("00")</div>
            <div class="metric-foot"><span class="metric-accent"></span><span>@T["dash.registered_in_system"]</span></div>
        </article>
    </section>

    <section class="overview-grid" aria-label="@T["dash.overview_label"]">
        <article class="panel availability-panel" id="fleet">
            <div class="panel-heading">
                <div><p class="panel-kicker">@T["dash.current_state"]</p><h2>@T["dash.availability"]</h2></div>
                <span class="panel-menu" aria-hidden="true">•••</span>
            </div>
            <div class="availability-content">
                <div class="availability-ring" style="--availability: @Model.AvailabilityPercentage" role="img" aria-label="@T["dash.availability_aria", Model.AvailabilityPercentage]">
                    <div class="ring-center"><strong>@Model.AvailabilityPercentage<span>%</span></strong><small>@T["dash.available_caps"]</small></div>
                </div>
                <div class="availability-summary">
                    <p><span class="legend-dot legend-available"></span><span>@T["dash.legend_available"]</span><strong>@Model.AvailableVehicleCount.ToString("00")</strong></p>
                    <p><span class="legend-dot legend-rented"></span><span>@T["dash.legend_rented"]</span><strong>@((Model.VehicleCount - Model.AvailableVehicleCount).ToString("00"))</strong></p>
                    <div class="summary-divider"></div>
                    <p class="summary-total"><span>@T["dash.total_fleet"]</span><strong>@Model.VehicleCount.ToString("00")</strong></p>
                </div>
            </div>
            <div class="panel-caption"><span class="caption-line"></span>@T["dash.state_caption"]</div>
        </article>

        <article class="panel activity-panel" id="rentals">
            <div class="panel-heading activity-heading">
                <div><p class="panel-kicker">@T["dash.movement"]</p><h2>@T["dash.recent_contracts"]</h2></div>
                <label class="table-search">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4.5 4.5"/></svg>
                    <span class="visually-hidden">@T["dash.search_contracts"]</span>
                    <input type="search" data-rental-search placeholder="@T["dash.search"]" autocomplete="off" />
                </label>
            </div>
            <div class="table-wrap">
                <table class="rental-table">
                    <thead><tr><th>@T["dash.th_customer_vehicle"]</th><th>@T["dash.th_period"]</th><th>@T["common.th_status"]</th></tr></thead>
                    <tbody data-rental-rows>
                    @if (Model.RecentRentals.Count == 0)
                    {
                        <tr class="empty-row"><td colspan="3"><div class="empty-state"><span class="empty-mark" aria-hidden="true">—</span><strong>@T["dash.empty_title"]</strong><span>@T["dash.empty_text"]</span></div></td></tr>
                    }
                    else
                    {
                        foreach (var rental in Model.RecentRentals)
                        {
                            var statusLabel = T[rental.IsActive ? "status.active" : rental.IsUpcoming ? "status.upcoming" : "status.completed"].Value;
                            var statusClass = rental.IsActive ? "is-active" : rental.IsUpcoming ? "is-upcoming" : "is-complete";
                            <tr data-rental-row>
                                <td><div class="customer-cell"><span class="customer-initials">@rental.CustomerName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()?.Substring(0, 1)</span><span><strong>@rental.CustomerName</strong><small>@rental.VehicleName <i>·</i> @rental.Registration</small></span></div></td>
                                <td><span class="date-range">@rental.StartDate.ToString("dd MMM") <i>→</i> @rental.EndDate.ToString("dd MMM yyyy")</span></td>
                                <td><span class="rental-status @statusClass"><i></i>@statusLabel</span></td>
                            </tr>
                        }
                        <tr class="no-search-results" data-no-results hidden><td colspan="3">@T["dash.no_search_results"]</td></tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="panel-bottom"><span>@T["dash.showing", Model.RecentRentals.Count, Model.RecentRentals.Count]</span><span class="table-period">@T["dash.recent_activity"]</span></div>
        </article>
    </section>

    <footer class="dashboard-footer"><span>GRUPOJAP RENTALS</span><span>@T["dash.footer_management"] <i>·</i> @DateTime.Today.Year</span></footer>
</section>
