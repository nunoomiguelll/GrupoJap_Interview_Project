@model Vehicle
@{ ViewData["Title"] = "Editar veículo"; }

<section class="management-page form-page">
    <div class="page-heading management-heading">
        <div>
            <p class="eyebrow">FROTA <span>·</span> EDIÇÃO</p>
            <h1>Editar veículo</h1>
            <p class="heading-copy">@Model.Brand @Model.Model · @Model.Registration</p>
        </div>
        <a class="secondary-button" asp-action="Index"><span aria-hidden="true">←</span> Voltar à frota</a>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="panel entity-form">
        <div asp-validation-summary="ModelOnly" class="form-errors" role="alert"></div>
        <input type="hidden" asp-for="Id" />
        <partial name="_Fields" model="Model" />
        <div class="form-actions"><a class="secondary-button" asp-action="Index">Cancelar</a><button class="primary-button" type="submit">Guardar alterações <span aria-hidden="true">→</span></button></div>
    </form>
</section>
@section Scripts { <partial name="_FormScripts" /> }
