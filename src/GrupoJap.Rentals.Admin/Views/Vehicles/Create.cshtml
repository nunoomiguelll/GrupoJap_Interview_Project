@model Vehicle
@{ ViewData["Title"] = T["vehicles.add"].Value; }

<section class="management-page form-page">
    <div class="page-heading management-heading">
        <div>
            <partial name="_Eyebrow" model="@T["vehicles.eyebrow_new"].Value" />
            <h1>@T["vehicles.add"]</h1>
            <p class="heading-copy">@T["vehicles.create_lead"]</p>
        </div>
        <a class="secondary-button" asp-action="Index"><span aria-hidden="true">←</span> @T["vehicles.back"]</a>
    </div>

    <form asp-action="Create" method="post" class="panel entity-form">
        <div asp-validation-summary="ModelOnly" class="form-errors" role="alert"></div>
        <partial name="_Fields" model="Model" />
        <div class="form-actions"><a class="secondary-button" asp-action="Index">@T["common.cancel"]</a><button class="primary-button" type="submit">@T["vehicles.save"] <span aria-hidden="true">→</span></button></div>
    </form>
</section>
@section Scripts { <partial name="_FormScripts" /> }
