@model IReadOnlyList<GrupoJap.Rentals.ViewModels.VehicleListItemViewModel>

@{
    ViewData["Title"] = "Veículos";
}

<section class="management-page">
    <div class="page-heading management-heading">
        <div>
            <p class="eyebrow">OPERAÇÃO <span>·</span> FROTA</p>
            <h1>Veículos</h1>
            <p class="heading-copy">@Model.Count veículo(s) registado(s)</p>
        </div>
        <a class="primary-button" asp-controller="Vehicles" asp-action="Create"><span aria-hidden="true">＋</span> Registar veículo</a>
    </div>

    <partial name="_Notices" />

    <section class="panel management-panel" aria-label="Lista de veículos">
        <div class="table-wrap">
            <table class="management-table">
                <thead><tr><th>VEÍCULO</th><th>MATRÍCULA</th><th>ANO</th><th>COMBUSTÍVEL</th><th>ESTADO</th><th></th></tr></thead>
                <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6"><div class="empty-state"><span class="empty-mark" aria-hidden="true">—</span><strong>A frota ainda não tem veículos</strong><span>Regista o primeiro veículo para começares a gerir disponibilidade e alugueres.</span><a class="text-link" asp-action="Create">Registar veículo <span aria-hidden="true">→</span></a></div></td></tr>
                }
                else
                {
                    foreach (var vehicle in Model)
                    {
                        <tr>
                            <td><div class="entity-cell"><span class="entity-symbol" aria-hidden="true">@vehicle.Brand.Substring(0, 1)</span><span><strong>@vehicle.Brand @vehicle.Model</strong></span></div></td>
                            <td><span class="plate-number">@vehicle.Registration</span></td>
                            <td>@vehicle.YearOfManufacture</td>
                            <td>@vehicle.FuelType.GetDisplayName()</td>
                            <td><span class="rental-status @(vehicle.IsRented ? "is-active" : "is-available")"><i></i>@(vehicle.IsRented ? "Alugado" : "Disponível")</span></td>
                            <td><div class="row-actions"><a asp-action="Edit" asp-route-id="@vehicle.Id">Editar</a><a class="is-danger" asp-action="Delete" asp-route-id="@vehicle.Id">Eliminar</a></div></td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </section>
</section>
