@model Vehicle
@{ ViewData["Title"] = T["vehicles.delete_title"].Value; int contractCount = ViewBag.ContractCount; }

<section class="management-page">
    <div class="page-heading management-heading">
        <div><partial name="_Eyebrow" model="@T["vehicles.eyebrow_delete"].Value" /><h1>@T["vehicles.delete_title"]</h1></div>
    </div>
    <div class="panel confirm-panel">
        <dl>
            <dt>@T["field.vehicle"]</dt><dd>@Model.Brand @Model.Model</dd>
            <dt>@T["field.registration"]</dt><dd>@Model.Registration</dd>
            <dt>@T["vehicles.th_year"]</dt><dd>@Model.YearOfManufacture</dd>
        </dl>
        @if (contractCount > 0)
        {
            <div class="notice notice-error" role="alert">@T["vehicles.delete_blocked", contractCount]</div>
            <div class="form-actions"><a class="secondary-button" asp-action="Index">@T["common.back"]</a></div>
        }
        else
        {
            <p>@T["vehicles.delete_confirm"]</p>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="form-actions">
                <a class="secondary-button" asp-action="Index">@T["common.cancel"]</a>
                <button class="danger-button" type="submit">@T["common.delete"]</button>
            </form>
        }
    </div>
</section>
