@model Vehicle
@{ ViewData["Title"] = "Eliminar veículo"; int contractCount = ViewBag.ContractCount; }

<section class="management-page">
    <div class="page-heading management-heading">
        <div><p class="eyebrow">FROTA <span>·</span> ELIMINAR</p><h1>Eliminar veículo</h1></div>
    </div>
    <div class="panel confirm-panel">
        <dl>
            <dt>Veículo</dt><dd>@Model.Brand @Model.Model</dd>
            <dt>Matrícula</dt><dd>@Model.Registration</dd>
            <dt>Ano</dt><dd>@Model.YearOfManufacture</dd>
        </dl>
        @if (contractCount > 0)
        {
            <div class="notice notice-error" role="alert">Este veículo tem @contractCount contrato(s) associado(s) e não pode ser eliminado.</div>
            <div class="form-actions"><a class="secondary-button" asp-action="Index">Voltar</a></div>
        }
        else
        {
            <p>Tens a certeza que queres eliminar este veículo? Esta ação não pode ser revertida.</p>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="form-actions">
                <a class="secondary-button" asp-action="Index">Cancelar</a>
                <button class="danger-button" type="submit">Eliminar</button>
            </form>
        }
    </div>
</section>
