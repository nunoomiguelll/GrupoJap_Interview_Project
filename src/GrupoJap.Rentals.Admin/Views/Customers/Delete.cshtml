@model Customer
@{ ViewData["Title"] = T["customers.delete_title"].Value; int contractCount = ViewBag.ContractCount; }

<section class="management-page">
    <div class="page-heading management-heading">
        <div><partial name="_Eyebrow" model="@T["customers.eyebrow_delete"].Value" /><h1>@T["customers.delete_title"]</h1></div>
    </div>
    <div class="panel confirm-panel">
        <dl>
            <dt>@T["field.full_name"]</dt><dd>@Model.FullName</dd>
            <dt>@T["field.email"]</dt><dd>@Model.Email</dd>
            <dt>@T["field.phone"]</dt><dd>@Model.Phone</dd>
        </dl>
        @if (contractCount > 0)
        {
            <div class="notice notice-error" role="alert">@T["customers.delete_blocked", contractCount]</div>
            <div class="form-actions"><a class="secondary-button" asp-action="Index">@T["common.back"]</a></div>
        }
        else
        {
            <p>@T["customers.delete_confirm"]</p>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="form-actions">
                <a class="secondary-button" asp-action="Index">@T["common.cancel"]</a>
                <button class="danger-button" type="submit">@T["common.delete"]</button>
            </form>
        }
    </div>
</section>
