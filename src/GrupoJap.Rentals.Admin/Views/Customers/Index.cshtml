@model IReadOnlyList<GrupoJap.Rentals.ViewModels.CustomerListItemViewModel>
@{ ViewData["Title"] = T["nav.customers"].Value; }

<section class="management-page">
    <div class="page-heading management-heading">
        <div>
            <partial name="_Eyebrow" model="@T["customers.eyebrow"].Value" />
            <h1>@T["nav.customers"]</h1>
            <p class="heading-copy">@T["customers.count", Model.Count]</p>
        </div>
        <a class="primary-button" asp-action="Create"><span aria-hidden="true">＋</span> @T["customers.add"]</a>
    </div>

    <partial name="_Notices" />

    <section class="panel management-panel" aria-label="@T["customers.list_label"]">
        <div class="table-wrap">
            <table class="management-table">
                <thead><tr><th>@T["customers.th_customer"]</th><th>@T["customers.th_phone"]</th><th>@T["customers.th_license"]</th><th>@T["customers.th_contracts"]</th><th>@T["common.th_status"]</th><th></th></tr></thead>
                <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6"><div class="empty-state"><span class="empty-mark" aria-hidden="true">—</span><strong>@T["customers.empty_title"]</strong><span>@T["customers.empty_text"]</span><a class="text-link" asp-action="Create">@T["customers.add"] <span aria-hidden="true">→</span></a></div></td></tr>
                }
                else
                {
                    foreach (var customer in Model)
                    {
                        <tr>
                            <td><div class="entity-cell"><span class="entity-symbol" aria-hidden="true">@customer.FullName.Substring(0, 1).ToUpperInvariant()</span><span><strong>@customer.FullName</strong><small>@customer.Email</small></span></div></td>
                            <td>@customer.Phone</td>
                            <td><span class="plate-number">@customer.DrivingLicenseNumber</span></td>
                            <td>@customer.ContractCount</td>
                            <td><span class="rental-status @(customer.HasActiveRental ? "is-active" : "is-complete")"><i></i>@T[customer.HasActiveRental ? "customers.status_active" : "customers.status_none"]</span></td>
                            <td><div class="row-actions"><a asp-action="Edit" asp-route-id="@customer.Id">@T["common.edit"]</a><a class="is-danger" asp-action="Delete" asp-route-id="@customer.Id">@T["common.delete"]</a></div></td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </section>
</section>
