@model IReadOnlyList<GrupoJap.Rentals.ViewModels.CustomerListItemViewModel>
@{ ViewData["Title"] = "Clientes"; }

<section class="management-page">
    <div class="page-heading management-heading">
        <div>
            <p class="eyebrow">OPERAÇÃO <span>·</span> CLIENTES</p>
            <h1>Clientes</h1>
            <p class="heading-copy">@Model.Count cliente(s) registado(s)</p>
        </div>
        <a class="primary-button" asp-action="Create"><span aria-hidden="true">＋</span> Registar cliente</a>
    </div>

    <partial name="_Notices" />

    <section class="panel management-panel" aria-label="Lista de clientes">
        <div class="table-wrap">
            <table class="management-table">
                <thead><tr><th>CLIENTE</th><th>TELEFONE</th><th>CARTA DE CONDUÇÃO</th><th>CONTRATOS</th><th>ESTADO</th><th></th></tr></thead>
                <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6"><div class="empty-state"><span class="empty-mark" aria-hidden="true">—</span><strong>Ainda não há clientes</strong><span>Regista o primeiro cliente para criares contratos de aluguer.</span><a class="text-link" asp-action="Create">Registar cliente <span aria-hidden="true">→</span></a></div></td></tr>
                }
                else
                {
                    foreach (var customer in Model)
                    {
                        <tr>
                            <td><div class="entity-cell"><span class="entity-symbol" aria-hidden="true">@customer.FullName.Substring(0, 1).ToUpperInvariant()</span><span><strong>@customer.FullName</strong><small>@customer.Email</small></span></div></td>
                            <td>@customer.Phone</td>
                            <td><span class="plate-number">@customer.DrivingLicenseNumber</span></td>
                            <td>@customer.ContractCount</td>
                            <td><span class="rental-status @(customer.HasActiveRental ? "is-active" : "is-complete")"><i></i>@(customer.HasActiveRental ? "Com aluguer ativo" : "Sem aluguer ativo")</span></td>
                            <td><div class="row-actions"><a asp-action="Edit" asp-route-id="@customer.Id">Editar</a><a class="is-danger" asp-action="Delete" asp-route-id="@customer.Id">Eliminar</a></div></td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </section>
</section>
