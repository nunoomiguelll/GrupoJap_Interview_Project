@model ErrorViewModel
@{
    ViewData["Title"] = T["error.title"];
}

<section class="page-hero">
    <div class="site-container">
        <p class="section-kicker">500</p>
        <h1>@T["error.title"]</h1>
        <p>@T["error.text"]</p>
        @if (Model.ShowRequestId)
        {
            <p><small>Request ID: <code>@Model.RequestId</code></small></p>
        }
        <a class="neon-button" href="~/">@T["common.back_home"]</a>
    </div>
</section>
