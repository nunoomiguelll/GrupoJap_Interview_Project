@model GrupoJap.Rentals.ViewModels.VehicleCardViewModel
@{
    var fuelClass = "fuel-" + Model.FuelType.ToString().ToLowerInvariant();
    var period = ViewData["PeriodQuery"] as string;
}
<article class="vehicle-card">
    <a class="vehicle-card-media @fuelClass" href="@Url.Action("Details", "Site", new { id = Model.Id })@period" tabindex="-1" aria-hidden="true">
        <partial name="_CarIllustration" />
        <span class="vehicle-year">@Model.YearOfManufacture</span>
    </a>
    <div class="vehicle-card-body">
        <div class="vehicle-card-title">
            <p class="vehicle-brand">@Model.Brand</p>
            <h3><a href="@Url.Action("Details", "Site", new { id = Model.Id })@period">@Model.Model</a></h3>
        </div>
        <ul class="vehicle-specs">
            <li>@T.Fuel(Model.FuelType)</li>
            <li>@Model.Mileage.ToString("N0") km</li>
        </ul>
        <div class="vehicle-card-foot">
            <span class="availability-pill @(Model.IsAvailable ? "is-free" : "is-busy")"><i></i>@T[Model.IsAvailable ? "vehicle.available" : "vehicle.rented"]</span>
            <a class="text-arrow" href="@Url.Action("Details", "Site", new { id = Model.Id })@period">@T["vehicle.details"] <span aria-hidden="true">→</span></a>
        </div>
    </div>
</article>
