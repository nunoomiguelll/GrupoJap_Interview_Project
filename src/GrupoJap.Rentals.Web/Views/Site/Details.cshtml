@model GrupoJap.Rentals.ViewModels.VehicleDetailsViewModel
@{
    var vehicle = Model.Vehicle;
    ViewData["Title"] = $"{vehicle.Brand} {vehicle.Model}";
    var today = DateTime.Today.ToString("yyyy-MM-dd");
    var fuelClass = "fuel-" + vehicle.FuelType.ToString().ToLowerInvariant();
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="site-container breadcrumb-trail">
    <a asp-action="Index">@T["nav.home"]</a><span aria-hidden="true">/</span>
    <a asp-action="Fleet">@T["nav.fleet"]</a><span aria-hidden="true">/</span>
    <a asp-action="Fleet" asp-route-brand="@vehicle.Brand">@vehicle.Brand</a><span aria-hidden="true">/</span>
    <strong>@vehicle.Model</strong>
</div>

<section class="site-container details-layout">
    <div class="details-main">
        <div class="details-media @fuelClass">
            <partial name="_CarIllustration" />
            <span class="availability-pill @(Model.IsAvailableToday ? "is-free" : "is-busy")"><i></i>@T[Model.IsAvailableToday ? "vehicle.available_today" : "vehicle.rented_today"]</span>
        </div>

        <div class="details-heading">
            <p class="vehicle-brand">@vehicle.Brand</p>
            <h1>@vehicle.Model</h1>
        </div>

        <dl class="spec-grid">
            <div><dt>@T["vehicle.year"]</dt><dd>@vehicle.YearOfManufacture</dd></div>
            <div><dt>@T["common.fuel"]</dt><dd>@T.Fuel(vehicle.FuelType)</dd></div>
            <div><dt>@T["vehicle.mileage"]</dt><dd>@vehicle.Mileage.ToString("N0") km</dd></div>
            <div><dt>@T["common.brand"]</dt><dd>@vehicle.Brand</dd></div>
        </dl>

        <section class="booked-periods" aria-labelledby="booked-title">
            <h2 id="booked-title">@T["vehicle.booked_title"]</h2>
            @if (Model.BookedPeriods.Count == 0)
            {
                <p class="muted-copy">@T["vehicle.booked_none"]</p>
            }
            else
            {
                <p class="muted-copy">@T["vehicle.booked_hint"]</p>
                <ul>
                    @foreach (var period in Model.BookedPeriods)
                    {
                        <li><span class="date-chip">@period.Start.ToString("dd/MM/yyyy")</span><span aria-hidden="true">→</span><span class="date-chip">@period.End.ToString("dd/MM/yyyy")</span></li>
                    }
                </ul>
            }
        </section>
    </div>

    <aside class="booking-card" id="reservar" aria-labelledby="booking-title">
        <h2 id="booking-title">@T["booking.title"]</h2>
        @if (User.Identity?.IsAuthenticated != true)
        {
            <p class="muted-copy">@T["booking.login_hint"]</p>
            <a class="neon-button neon-button-block" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl">@T["booking.login_cta"]</a>
            <a class="site-link-button site-link-block" asp-controller="Account" asp-action="Register">@T["account.create"]</a>
        }
        else
        {
            <form asp-action="Book" asp-route-id="@vehicle.Id" method="post" class="booking-form" data-date-range>
                <div asp-validation-summary="ModelOnly" class="form-errors" role="alert"></div>
                <div class="field-group">
                    <label asp-for="Booking.StartDate"></label>
                    <input asp-for="Booking.StartDate" type="date" min="@today" data-range-start />
                    <span asp-validation-for="Booking.StartDate"></span>
                </div>
                <div class="field-group">
                    <label asp-for="Booking.EndDate"></label>
                    <input asp-for="Booking.EndDate" type="date" min="@today" data-range-end />
                    <span asp-validation-for="Booking.EndDate"></span>
                </div>
                <p class="booking-days" data-range-days data-template="@T["booking.days_label"]" hidden></p>

                @if (Model.Booking.NeedsCustomerData)
                {
                    <div class="booking-note">@T["booking.first_note"]</div>
                    <div class="field-group">
                        <label asp-for="Booking.Phone"></label>
                        <input asp-for="Booking.Phone" type="tel" inputmode="numeric" maxlength="9" placeholder="@T["booking.phone_placeholder"]" required />
                        <span asp-validation-for="Booking.Phone"></span>
                    </div>
                    <div class="field-group">
                        <label asp-for="Booking.DrivingLicenseNumber"></label>
                        <input asp-for="Booking.DrivingLicenseNumber" maxlength="30" autocomplete="off" required />
                        <span asp-validation-for="Booking.DrivingLicenseNumber"></span>
                    </div>
                }

                <button class="neon-button neon-button-block" type="submit">@T["booking.submit"] <span aria-hidden="true">→</span></button>
                <p class="booking-small">@T["booking.cancel_policy"]</p>
            </form>
        }
    </aside>
</section>

@if (Model.Related.Count > 0)
{
    <section class="site-section">
        <div class="site-container">
            <div class="section-heading">
                <div>
                    <p class="section-kicker">@T["vehicle.related_kicker"]</p>
                    <h2>@T["vehicle.related_title"]</h2>
                </div>
            </div>
            <div class="vehicle-grid">
                @foreach (var related in Model.Related)
                {
                    <partial name="_VehicleCard" model="related" />
                }
            </div>
        </div>
    </section>
}

@section Scripts { <partial name="_FormScripts" /> }
