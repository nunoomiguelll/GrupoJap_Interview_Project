@model GrupoJap.Rentals.ViewModels.MyBookingsViewModel
@using GrupoJap.Rentals.Services
@{ ViewData["Title"] = T["nav.my_bookings"]; }

<section class="page-hero">
    <div class="site-container">
        <p class="section-kicker">@T["bookings.kicker"]</p>
        <h1>@T["bookings.hello", Model.DisplayName]</h1>
        <p>@T["bookings.lead"]</p>
    </div>
</section>

<div class="site-container bookings-page">
    <partial name="_Notices" />

    @if (Model.Bookings.Count == 0)
    {
        <div class="site-empty">
            <strong>@T["bookings.empty_title"]</strong>
            <span>@T["bookings.empty_text"]</span>
            <a class="neon-button" asp-action="Fleet">@T["bookings.empty_cta"]</a>
        </div>
    }
    else
    {
        <ul class="booking-list">
            @foreach (var booking in Model.Bookings)
            {
                var (css, label) = booking.Status switch
                {
                    RentalStatus.Active => ("is-free", T["bookings.status.active"]),
                    RentalStatus.Upcoming => ("is-upcoming", T["bookings.status.upcoming"]),
                    _ => ("is-past", T["bookings.status.past"])
                };
                <li class="booking-item">
                    <div class="booking-item-media fuel-@booking.FuelType.ToString().ToLowerInvariant()"><partial name="_CarIllustration" /></div>
                    <div class="booking-item-body">
                        <span class="availability-pill @css"><i></i>@label</span>
                        <h2><a asp-action="Details" asp-route-id="@booking.VehicleId">@booking.VehicleName</a></h2>
                        <p class="booking-dates">
                            <span class="date-chip">@booking.StartDate.ToString("dd/MM/yyyy")</span><span aria-hidden="true">→</span><span class="date-chip">@booking.EndDate.ToString("dd/MM/yyyy")</span>
                            <small>@T["bookings.days", booking.Days] · @T.Fuel(booking.FuelType)</small>
                        </p>
                    </div>
                    @if (booking.CanCancel)
                    {
                        <form asp-action="CancelBooking" asp-route-id="@booking.Id" method="post" class="booking-item-actions" data-confirm="@T["bookings.cancel_confirm"]">
                            <button class="site-link-button" type="submit">@T["bookings.cancel"]</button>
                        </form>
                    }
                </li>
            }
        </ul>
    }
</div>
