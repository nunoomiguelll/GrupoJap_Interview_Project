@model GrupoJap.Rentals.ViewModels.SiteHomeViewModel
@{
    ViewData["Title"] = T["home.title"];
    var today = DateTime.Today.ToString("yyyy-MM-dd");
    var tomorrow = DateTime.Today.AddDays(1).ToString("yyyy-MM-dd");
}

<section class="hero">
    <div class="hero-media" aria-hidden="true">
        <video class="hero-video" autoplay muted loop playsinline preload="auto" disablepictureinpicture tabindex="-1" data-hero-video>
            <source src="~/media/hero-sportscar.mp4" type="video/mp4" />
        </video>
        <div class="hero-overlay"></div>
    </div>
    <div class="site-container hero-grid">
        <div class="hero-copy">
            <p class="hero-kicker"><span class="neon-dot" aria-hidden="true"></span> @T["home.hero.kicker"]</p>
            <h1>@T["home.hero.title"] <span class="neon-text">@T["home.hero.highlight"]</span>.</h1>
            <p class="hero-lead">@T["home.hero.lead"]</p>
            <dl class="hero-stats">
                <div><dt>@T["home.stats.fleet"]</dt><dd>@Model.VehicleCount</dd></div>
                <div><dt>@T["common.available_today"]</dt><dd>@Model.AvailableTodayCount</dd></div>
                <div><dt>@T["home.stats.brands"]</dt><dd>@Model.DistinctBrandCount</dd></div>
            </dl>
        </div>

        <form class="search-card" asp-controller="Site" asp-action="Fleet" method="get" data-date-range>
            <h2>@T["home.search.title"]</h2>
            <div class="search-fields">
                <label class="search-field"><span>@T["common.pickup"]</span><input type="date" name="start" min="@today" value="@today" data-range-start required /></label>
                <label class="search-field"><span>@T["common.return"]</span><input type="date" name="end" min="@tomorrow" value="@tomorrow" data-range-end required /></label>
                <label class="search-field"><span>@T["common.brand"]</span>
                    <select name="brand">
                        <option value="">@T["common.all_brands"]</option>
                        @foreach (var brand in Model.Brands)
                        {
                            <option value="@brand.Brand">@brand.Brand</option>
                        }
                    </select>
                </label>
                <label class="search-field"><span>@T["common.fuel"]</span>
                    <select name="fuel">
                        <option value="">@T["common.all_masc"]</option>
                        @foreach (var fuel in Enum.GetValues<FuelType>().Where(f => f != FuelType.Unspecified))
                        {
                            <option value="@fuel">@T.Fuel(fuel)</option>
                        }
                    </select>
                </label>
            </div>
            <input type="hidden" name="onlyAvailable" value="true" />
            <button class="neon-button neon-button-lg" type="submit">@T["home.search.submit"] <span aria-hidden="true">→</span></button>
        </form>
    </div>

    @if (Model.Fuels.Count > 0)
    {
        <div class="site-container popular-searches">
            <span>@T["home.popular"]</span>
            <a asp-action="Fleet" asp-route-onlyAvailable="true">@T["common.available_today"]</a>
            @foreach (var fuel in Model.Fuels.Where(f => f.FuelType != FuelType.Unspecified))
            {
                <a asp-action="Fleet" asp-route-fuel="@fuel.FuelType">@T.Fuel(fuel.FuelType) <small>@fuel.Count</small></a>
            }
        </div>
    }
</section>

<section class="site-section">
    <div class="site-container">
        <div class="section-heading">
            <div>
                <p class="section-kicker">@T["home.featured.kicker"]</p>
                <h2>@T["common.available_today"]</h2>
            </div>
            <a class="text-arrow" asp-action="Fleet">@T["common.see_all_vehicles"] <span aria-hidden="true">→</span></a>
        </div>

        @if (Model.Featured.Count == 0)
        {
            <div class="site-empty">
                <strong>@T["home.featured.empty_title"]</strong>
                <span>@T["home.featured.empty_text"]</span>
                <a class="neon-button" asp-action="Fleet">@T["home.featured.empty_cta"]</a>
            </div>
        }
        else
        {
            <div class="carousel carousel-vehicles" data-carousel aria-roledescription="carousel" aria-label="@T["common.available_today"]"
                 data-label-prev="@T["carousel.prev"]" data-label-next="@T["carousel.next"]" data-label-goto="@T["carousel.goto"]">
                <div class="carousel-viewport">
                    <div class="carousel-track" data-carousel-track>
                        @foreach (var vehicle in Model.Featured)
                        {
                            <div class="carousel-slide"><partial name="_VehicleCard" model="vehicle" /></div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@if (Model.Brands.Count > 0)
{
    <section class="site-section site-section-tint">
        <div class="site-container">
            <div class="section-heading">
                <div>
                    <p class="section-kicker">@T["home.stats.brands"]</p>
                    <h2>@T["home.brands.title"]</h2>
                </div>
            </div>
            <div class="carousel carousel-brands" data-carousel aria-roledescription="carousel" aria-label="@T["home.stats.brands"]"
                 data-label-prev="@T["carousel.prev"]" data-label-next="@T["carousel.next"]" data-label-goto="@T["carousel.goto"]">
                <div class="carousel-viewport">
                    <div class="carousel-track" data-carousel-track>
                        @foreach (var brand in Model.Brands)
                        {
                            <div class="carousel-slide">
                                <a class="brand-tile" asp-action="Fleet" asp-route-brand="@brand.Brand">
                                    <span class="brand-initial" aria-hidden="true">@brand.Brand[..1].ToUpperInvariant()</span>
                                    <strong>@brand.Brand</strong>
                                    <small>@T["home.brands.count", brand.Count]</small>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
}

<section class="site-section" id="como-funciona">
    <div class="site-container">
        <div class="section-heading section-heading-center">
            <div>
                <p class="section-kicker">@T["nav.how"]</p>
                <h2>@T["home.how.title"]</h2>
            </div>
        </div>
        <ol class="steps">
            <li>
                <span class="step-number">01</span>
                <h3>@T["home.how.step1_title"]</h3>
                <p>@T["home.how.step1_text"]</p>
            </li>
            <li>
                <span class="step-number">02</span>
                <h3>@T["home.how.step2_title"]</h3>
                <p>@T["home.how.step2_text"]</p>
            </li>
            <li>
                <span class="step-number">03</span>
                <h3>@T["home.how.step3_title"]</h3>
                <p>@T["home.how.step3_text"]</p>
            </li>
        </ol>
    </div>
</section>

<section class="site-section site-section-dark">
    <div class="site-container why-grid">
        <div>
            <p class="section-kicker">@T["home.why.kicker"]</p>
            <h2>@T["home.why.title"]</h2>
            <p class="why-lead">@T["home.why.lead"]</p>
        </div>
        <ul class="why-list">
            @for (var item = 1; item <= 4; item++)
            {
                <li><strong>@T[$"home.why.item{item}_title"]</strong><span>@T[$"home.why.item{item}_text"]</span></li>
            }
        </ul>
    </div>
</section>

<section class="site-section">
    <div class="site-container cta-band">
        <div>
            <h2>@T["home.cta.title"]</h2>
            <p>@T["home.cta.text"]</p>
        </div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="neon-button neon-button-lg" asp-action="Fleet">@T["home.cta.explore"] <span aria-hidden="true">→</span></a>
        }
        else
        {
            <a class="neon-button neon-button-lg" asp-controller="Account" asp-action="Register">@T["account.create"] <span aria-hidden="true">→</span></a>
        }
    </div>
</section>
