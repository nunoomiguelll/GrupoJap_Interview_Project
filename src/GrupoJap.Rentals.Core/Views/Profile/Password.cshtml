@model GrupoJap.Rentals.ViewModels.ChangePasswordViewModel
@{ ViewData["Title"] = T["profile.change_password"]; Layout = "_Layout"; }

<section class="management-page form-page">
    <div class="page-heading management-heading">
        <div>
            <p class="eyebrow">@T["password.eyebrow"]</p>
            <h1>@T["profile.change_password"]</h1>
            <p class="heading-copy">@T["password.lead"]</p>
        </div>
        <a class="secondary-button" asp-action="Index"><span aria-hidden="true">←</span> @T["password.back"]</a>
    </div>

    <form asp-action="Password" method="post" class="panel entity-form">
        <div asp-validation-summary="ModelOnly" class="form-errors" role="alert"></div>
        <div class="form-grid">
            <div class="field-group"><label asp-for="CurrentPassword"></label><input asp-for="CurrentPassword" autocomplete="current-password" /><span asp-validation-for="CurrentPassword"></span></div>
            <span></span>
            <div class="field-group"><label asp-for="NewPassword"></label><input asp-for="NewPassword" autocomplete="new-password" /><span asp-validation-for="NewPassword"></span></div>
            <div class="field-group"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div>
        </div>
        <div class="form-actions"><a class="secondary-button" asp-action="Index">@T["common.cancel"]</a><button class="primary-button" type="submit">@T["profile.change_password"] <span aria-hidden="true">→</span></button></div>
    </form>
</section>
@section Scripts { <partial name="_FormScripts" /> }
